# Configuração do backup do GenieACS: copie para /etc/genieacs-backup/backup.env (chmod 600).
# A senha de criptografia dos backups fica em /etc/genieacs-backup/senha (guarde uma cópia FORA do servidor:
# sem ela os backups não abrem).

# Destino (termine com /). Exemplos:
#   ftp://ftp.exemplo.com.br/backups/genieacs/      (com FTP_TLS=1 vira FTPS explícito, recomendado)
#   sftp://servidor.exemplo.com.br/backups/genieacs/
DESTINO_URL=
DESTINO_USUARIO=
DESTINO_SENHA=
FTP_TLS=1
# SFTP com chave em vez de senha (opcional)
DESTINO_CHAVE=

# Quantos guardar: no destino, os N mais recentes + 1 por semana; neste servidor, os N mais recentes
MANTER_DIARIOS=14
MANTER_SEMANAIS=8
MANTER_LOCAIS=3

# Portal (inclui os dados do portal no backup e usa a API de restauração)
PORTAL_URL=http://172.16.0.134:8080
TOKEN=
BACKUP_PORTA=7570
