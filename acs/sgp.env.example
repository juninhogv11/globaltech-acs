# Configuração das extensões "sistema" (SGP) e "wifibackup", lida a cada consulta.
# No servidor do GenieACS: copie para /opt/genieacs/sgp.env e proteja:
#   chown genieacs:genieacs /opt/genieacs/sgp.env && chmod 600 /opt/genieacs/sgp.env

# Sistema de gestão de clientes: sgp ou hubsoft
SISTEMA=sgp

# API do SGP (SISTEMA=sgp)
SGP_HOST=suaempresa.sgp.net.br
SGP_APP=
SGP_TOKEN=

# API do Hubsoft (SISTEMA=hubsoft): URL da API, client_id, client_secret, usuário e senha da API,
# criados pelo usuário administrador do provedor no Hubsoft (https://docs.hubsoft.com.br)
HUBSOFT_URL=https://api.suaempresa.hubsoft.com.br
HUBSOFT_CLIENT_ID=
HUBSOFT_CLIENT_SECRET=
HUBSOFT_USUARIO=
HUBSOFT_SENHA=

# Endereço do portal (a extensão wifibackup busca a cópia do Wi-Fi aqui)
WIFI_PORTAL_URL=http://192.168.10.3:8080
