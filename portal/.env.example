# Configuração do Portal Globaltech ACS (copiado para /opt/globaltech-portal/.env na instalação)

# API NBI do GenieACS
NBI_URL=http://192.168.10.2:7557

# O portal escuta só localmente; o nginx publica na porta configurada no install.sh
HOST=127.0.0.1
PORT=3100

# Minutos sem inform para considerar o equipamento offline
ONLINE_MINUTES=6

# Endereço do SGP (o código do cliente na página do dispositivo abre a ficha em nova aba)
SGP_URL=https://suaempresa.sgp.net.br

SESSION_HOURS=12
# 1 quando o portal estiver atrás de HTTPS
COOKIE_SECURE=0

# Teste de velocidade (TR-143)
# Arquivo que o roteador baixa no teste de download
SPEEDTEST_DOWNLOAD_URL=http://acs.exemplo.com.br/100MB.bin
# Endereço deste portal visto pelos roteadores (recebe o upload)
SPEEDTEST_UPLOAD_BASE=http://192.168.10.3:8080/speedtest/upload
SPEEDTEST_UPLOAD_BYTES=104857600

# IP(s) do servidor GenieACS que podem ler a cópia do Wi-Fi (restauração após reset)
WIFI_BACKUP_ALLOW=192.168.10.2
