# Configuração do Portal Globaltech ACS (copiado para /opt/globaltech-portal/.env na instalação)

# API NBI do GenieACS
NBI_URL=http://192.168.10.2:7557

# O portal escuta só localmente; o nginx publica na porta configurada no install.sh
HOST=127.0.0.1
PORT=3100

# Minutos sem inform para considerar o equipamento offline
ONLINE_MINUTES=6

# Endereço do SGP (o código do cliente na página do dispositivo abre a ficha em nova aba)
SGP_URL=https://suaempresa.sgp.net.br

SESSION_HOURS=12
# 1 quando o portal estiver atrás de HTTPS
COOKIE_SECURE=0

# Teste de velocidade (TR-143)
# Arquivo que o roteador baixa no teste de download
SPEEDTEST_DOWNLOAD_URL=http://acs.exemplo.com.br/100MB.bin
# Endereço deste portal visto pelos roteadores (recebe o upload)
SPEEDTEST_UPLOAD_BASE=http://192.168.10.3:8080/speedtest/upload
SPEEDTEST_UPLOAD_BYTES=104857600

# IP(s) do servidor GenieACS que podem ler a cópia do Wi-Fi (restauração após reset) e os dados para o backup
WIFI_BACKUP_ALLOW=192.168.10.2

# Assistente de suporte com IA (API compatível com OpenAI). Vazio = só o diagnóstico por regras.
# Groq (gratuito, sem cartão):   IA_URL=https://api.groq.com/openai/v1   IA_MODELO=<modelo da lista do console>
# Gemini (gratuito; no plano grátis o Google pode usar as conversas): IA_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_URL=
IA_CHAVE=
IA_MODELO=
# Pode ser uma lista (o próximo é usado se um estiver sobrecarregado ou sem cota), ex. Gemini:
#   IA_MODELO=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
# Provedores de reserva (usados quando o 1º está sem cota, sobrecarregado ou fora do ar). Opcional.
# OpenAI (ChatGPT) é PAGO por uso: chave em platform.openai.com com crédito; use um modelo pequeno.
#   IA2_URL=https://api.openai.com/v1   IA2_CHAVE=...   IA2_MODELO=<modelo pequeno da lista da OpenAI>
IA2_URL=
IA2_CHAVE=
IA2_MODELO=
# Teto diário de perguntas no portal (o provedor também tem limite próprio)
IA_LIMITE_DIA=300

# Backups: API de backup no servidor GenieACS (genieacs-backup.js serve) e o mesmo TOKEN do backup.env de lá
BACKUP_AGENT_URL=http://192.168.10.2:7570
BACKUP_TOKEN=
